{
  "name": "clone_tabnews",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run wait-for-database && next dev",
    "services:up": "docker compose --env-file .env.development -f infra/compose.yaml up -d",
    "services:stop": "docker compose --env-file .env.development -f infra/compose.yaml stop",
    "services:down": "docker compose --env-file .env.development -f infra/compose.yaml down",
    "migrations:create": "node-pg-migrate --template-file-name infra/migration-template.cjs -m infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "eslint:check": "next lint --dir .",
    "eslint:fix": "next lint --fix",
    "test": "npm run services:up && npm run wait-for-database && concurrently -n next,jest --hide next -k -s command-jest \"next dev\" \"jest --runInBand --verbose\"",
    "test:watch": "jest --watchAll --runInBand",
    "wait-for-database": "npx tsx infra/scripts/wait-for-database.ts",
    "prepare": "husky",
    "commit": "cz"
  },
  "dependencies": {
    "async-retry": "1.3.3",
    "dotenv": "16.4.5",
    "next": "14.2.5",
    "node-pg-migrate": "7.6.1",
    "pg": "8.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "19.4.0",
    "@commitlint/config-conventional": "19.2.2",
    "@types/async-retry": "1.4.9",
    "@types/jest": "29.5.14",
    "@types/node": "18.19.130",
    "@types/react": "18.3.31",
    "@typescript-eslint/eslint-plugin": "7.2.0",
    "commitizen": "4.3.0",
    "concurrently": "8.2.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-jest": "28.14.0",
    "husky": "9.1.4",
    "jest": "29.7.0",
    "prettier": "3.3.3",
    "ts-jest": "29.4.12",
    "tsx": "4.23.15",
    "typescript": "4.9.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
